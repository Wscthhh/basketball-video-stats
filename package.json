{
  "name": "courttrace",
  "private": true,
  "version": "0.1.6",
  "description": "COURTTRACE local basketball video analysis desktop app",
  "author": "COURTTRACE",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "desktop:prepare": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "desktop:build": "npm run build",
    "desktop:prepare-runtime": "powershell -ExecutionPolicy Bypass -File scripts/build-desktop.ps1",
    "desktop:runtime": "npm run desktop:prepare-runtime && powershell -ExecutionPolicy Bypass -File scripts/build-runtime.ps1",
    "desktop:runtime-installer": "npm run desktop:runtime && powershell -ExecutionPolicy Bypass -File scripts/build-runtime-installer.ps1",
    "desktop:package": "npm run desktop:build && electron-builder --win nsis",
    "desktop:inno": "npm run build && powershell -ExecutionPolicy Bypass -File scripts/build-inno.ps1"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "lucide-vue-next": "^0.468.0",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "typescript": "~5.7.2",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.4"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.courttrace.desktop",
    "productName": "COURTTRACE",
    "directories": {
      "output": "release"
    },
    "compression": "store",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/7zip-bin/win/x64/7za.exe",
        "to": "tools/7za.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "artifactName": "COURTTRACE-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Wscthhh",
        "repo": "basketball-video-stats"
      }
    ]
  }
}
